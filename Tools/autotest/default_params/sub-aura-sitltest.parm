# AURA AUV - SITL + QGC JOYSTICK override (GERCEK ARAC DEGIL, sadece simulasyon).
# Yukleme sirasi: sub-6dof.parm -> sub-aura.parm -> BU DOSYA (--add-param-file, en son = kazanir)
# Amac: kolay arm, yay-merkezli QGC joystick (MANUAL_CONTROL) ile temiz surus, stabil kalma.

# ===== (1) ZORUNLU: arming + joystick kontrolu =====
# 4.7: ARMING_CHECK 0 -> ARMING_SKIPCHK -1 (upstream donusumu: checks_old==0 ise -1,
# "tum zorunlu-olmayan mevcut ve gelecek kontrolleri atla").
ARMING_SKIPCHK   -1       # gercek arac 448; RC-channels on-kosulu SITL'de joystick arm'i engeller
RC_OPTIONS       0        # gercek=32 (strict-RC biti); duz RC-override yolu
RC3_TRIM         1500     # gercek arac ile AYNI (sub-aura.parm'daki gerekce blokuna bak).
                          # 26 Tem'de 1100'du ve o zaman DOGRUYDU: 4.5.3'te MANUAL
                          # set_throttle(norm_input()) yapiyordu. 4.7 bunu
                          # set_throttle((norm_input()+1)/2) olarak degistirdi; TRIM==MIN iken
                          # norm_input() negatif donmedigi icin gaz kolu olu kaldi (SITL: dikey
                          # hiz araligi 0.04 m/s). 1500 ile simetrik -1..+1 geri geldi (1.13 m/s).
                          # "Eski 1500 denemesi kalici itki birakiyordu" notu 4.5.3'e aitti,
                          # 4.7'de gecersiz -- iki surumde DOGRU DEGER TERS.

# ===== Motor yonleri: sim BlueROV2-Heavy geometrisi -> ArduSub VARSAYILANI (+1) =====
# (Gercek aracin MOT_x_DIRECTION kalibrasyonu sim geometrisine UYMAZ; "ileri" komutu yana surer.
#  Ajan A matematikle ispatladi + odometri ile dogrulandi: +1 ile ileri = temiz +x.)
MOT_1_DIRECTION  1
MOT_2_DIRECTION  1
MOT_3_DIRECTION  1
MOT_4_DIRECTION  1
MOT_5_DIRECTION  1
MOT_6_DIRECTION  1
MOT_7_DIRECTION  1
MOT_8_DIRECTION  1

# ===== (2) STABILITE / GERCEKCILIK =====
BARO_PRIMARY     0        # gercek birincil baro #3 (harici); SITL sadece baro #0 simule eder
PSC_D_ACC_IMAX   0.5      # gercek=0.1 (4.5'te 100); sim govdesi agir/yuzdurmesi farkli ->
                          # dikey ivme kontrolcusunun I payi doyup derinlik hedefine oturamiyordu
# EKF (EK3) + DVL/ExternalNav kaynak TANIMLARI last.params'tan gelir, EZILMEZ:
#   sub-aura.parm: AHRS_EKF_TYPE=3, EK3_SRC1_POSXY/VELXY=6 (ExternalNav/DVL), POSZ=1 (baro),
#   YAW=1 (pusula), VISO_TYPE=1, VISO_POS/VEL/YAW_M_NSE gurultu ayarlari.
# Burada SADECE SITL GPS'i kapatiyoruz -> EKF origin'i MANUEL set edilir (SET_GPS_GLOBAL_ORIGIN).
# DVL verisi gz yer-gercekinden ArduSub'a ExternalNav (VISION_*) kopru node ile beslenir.
GPS1_TYPE        0
# Gorev fotografi (mission_photo.py): kamera backend'i MAVLink olsun ki otopilot
# DO_DIGICAM_CONTROL'u (203) MAVLink agina yayinlasin (gercek aracta da ayni ayar).
CAM1_TYPE        5
# Seyirde yaw OTOMATIK: 4 = CORRECT_XTRACK, burun hat kerterizine doner.
# (1 denendi: pos controller yaw'i Sub AUTO'da guncellemiyor, arac hic donmedi.)
# 4'un sifir-uzunluklu-bacak belasi (kuzeye donme) fork'ta yamali:
# mode_guided.cpp get_auto_heading CORRECT_XTRACK, <0.5 m yatay hatta mevcut
# yaw hedefini korur. CONDITION_YAW mission'da yalniz kamera yonu icin.
WP_YAW_BEHAVIOR  4
# CAN'i SITL'de KAPAT (gercek=1, DroneCAN). CAN_P1_DRIVER=1 iken SITL arac durumunu
# multicast UDP ile (239.255.145.51:20721) yayinlar; INTERNETSIZKEN multicast route'u
# olmadigindan connect() 'Network is unreachable' -> ardusub exit(1) -> 5760 acilmaz
# -> QGC baglanamaz. Bu akista CAN sim kullanilmaz (itki JSON/Gazebo FDM, DVL ExternalNav).
CAN_P1_DRIVER    0
# Pusula: gercek hard/soft-iron kalibrasyonunu sil (SITL SIM_MAG_OFS=0 -> dogru cal sifir)
COMPASS_OFS_X    0
COMPASS_OFS_Y    0
COMPASS_OFS_Z    0
COMPASS_OFS2_X   0
COMPASS_OFS2_Y   0
COMPASS_OFS2_Z   0
COMPASS_DIA_X    1
COMPASS_DIA_Y    1
COMPASS_DIA_Z    1
COMPASS_DIA2_X   1
COMPASS_DIA2_Y   1
COMPASS_DIA2_Z   1
COMPASS_ODI_X    0
COMPASS_ODI_Y    0
COMPASS_ODI_Z    0
COMPASS_ODI2_X   0
COMPASS_ODI2_Y   0
COMPASS_ODI2_Z   0
COMPASS_DEV_ID   0
COMPASS_DEV_ID2  0
COMPASS_PRIO1_ID 0
COMPASS_PRIO2_ID 0
# Sürüş sırasında disarm yapabilecek failsafe'ler
FS_PILOT_INPUT   0        # gercek=2 (manuel girdi >3s durunca disarm)
FS_GCS_ENABLE    0        # gercek=2 (GCS heartbeat kaybinda disarm)
FS_LEAK_ENABLE   0        # SITL'de kacak sensoru yok

# ===== (2b) FAZ 2 — IMU GERCEKCILIK (gurultu / bias / drift / motor-titresim) =====
# Golcuk gercekcilik calismasi. NOT: ArduSub SITL KENDI IMU'sunu uretir -> gurultu
# gz <imu><noise> ile DEGIL, SITL SIM_* ile verilir. Parametre adlari/birimleri
# aurapilot libraries/SITL/SITL.cpp'den DOGRULANDI (SIM_ACC_RND diye TEKIL param YOK;
# IMU basina ACC1/ACC2/ACC3). Gercek arac DEGIL; amac EKF'i gercekci imperfect IMU
# ile beslemek. Kademeli: gerekirse gate testinde artir/azalt.
# -- Motor titresimi (itici -> IMU kuplaj); "motor noise factor", yalniz motor calisinca etkir --
SIM_VIB_MOT_MAX  40       # Hz, itici titresim baz frekansi (T200 sinifi ~ onlarca Hz)
SIM_ACC1_RND     0.20     # accel #1 motor titresim olcegi
SIM_ACC2_RND     0.20
SIM_ACC3_RND     0.20
SIM_GYR1_RND     0.20     # gyro #1 motor titresim olcegi
SIM_GYR2_RND     0.20
SIM_GYR3_RND     0.20
# -- Gyro yavas kaymasi (bias-instability / random-walk); SITL varsayilani 0.05/5 --
SIM_DRIFT_SPEED  0.08     # deg/s/dk, gyro drift hizi (hafif gercekci artis)
SIM_DRIFT_TIME   5        # dk, bir tam drift periyodu
# -- Sabit accel bias (kalibrasyon artigi, ICM-20602/MPU6000 sinifi), m/s^2 --
SIM_ACC1_BIAS_X  0.03
SIM_ACC1_BIAS_Y  -0.02
SIM_ACC1_BIAS_Z  0.03

# ===== (2c) FAZ 3 — DVL olcum gurultusu kalibrasyonu =====
# DVL koprusu (docker/dvl_bridge.py) hiza ~0.05 m/s beyaz gurultu + %1 scale + %3
# dropout + nadir outlier enjekte eder. EKF'in bekledigi olcum gurultusu bununla
# uyumlu olmali (innov ~chi2). Gercek arac VISO_VEL_M_NSE=0.1; SITL'de enjekte edilene
# kalibre: 0.07 (~1.4x enjekte sigma). VISO_POS_M_NSE=0.2 zaten enjekte 0.02'nin uzerinde.
VISO_VEL_M_NSE   0.07

# ===== (3) OPSIYONEL: temizlik (EKF biaslari zaten ogrenir) =====
INS_ACCOFFS_X    0
INS_ACCOFFS_Y    0
INS_ACCOFFS_Z    0
INS_ACC2OFFS_X   0
INS_ACC2OFFS_Y   0
INS_ACC2OFFS_Z   0
INS_ACC3OFFS_X   0
INS_ACC3OFFS_Y   0
INS_ACC3OFFS_Z   0
AHRS_TRIM_X      0
AHRS_TRIM_Y      0
# --- TABAN MESAFESI (2026-08-20) ---
# Eskiden 0 idi: SITL'de rangefinder besleyen bir sey YOKTU, acik birakmak
# "unhealthy" prearm uyarisi uretiyordu. Artik var: modelde asagi bakan tek
# isinli gpu_lidar (aura_auv_sitl/model.sdf altimetre_link) +
# simulation/docker/rangefinder_bridge.py -> DISTANCE_SENSOR (orient 25).
# 10 = MAVLink; GERCEK ARACTA DA 10 (Tracker 650 standoff'u SonarView ile
# enjekte ediliyor) -> SURFTRAK ve terrain-frame gorevler icin firmware yolu
# sim ile arac arasinda BIREBIR ayni.
# POS_Z: gz sensoru govde merkezinin 0.22 m ALTINDA (FLU z=-0.22); ArduPilot
# govde cercevesi FRD oldugu icin +0.22. Isin govde gorseline carpmasin diye
# asagi kondu -- gpu_lidar collision'i degil VISUAL'i gorur.
RNGFND1_TYPE     10
RNGFND1_POS_Z    0.22

# --- YAW SONUMU (YALNIZ SITL — gercek arac tuning'i sub-aura.parm'da DEGISMEDI) ---
# Sim'de arac otelenirken burnu +/-13 deg salinip duruyordu: yaw hiz dongusunde D terimi
# YOK (ATC_RAT_YAW_D=0), yani otelenmenin urettigi yaw momenti sonumlenmiyor. Arac
# DURURKEN salinim yok (POSHOLD'da 20 sn'de 0.1 deg), akinti da sebep degil (kapatinca
# 24.6 vs 26.0 deg -> fark yok). Olcum (8 m otelenme, komut -90 deg, ort/max sapma):
# ONEMLI: kararsizlik ILERI harekete ozgudur. Ayni testin yan (strafe) hali P=0.30
# D=0.015 ile 0.3 deg salinim verirken ILERI hali 16.5 deg veriyordu -- yani sorun
# otelenmenin yonune bagli bir yaw kuplaji (sim itici geometrisi BlueROV2-Heavy
# referansi + MOT_*_DIRECTION override'i; bkz. GELISTIRME_OZETI 3. tablo).
# ILERI harekette olcum (8 m, komut -90 deg; salinim / ort sapma / max):
#   P=0.18 D=0                   -> 16.5 / 5.84 / 13.05 deg
#   P=0.30 D=0.015               -> 14.6 / 1.10 /  7.43 deg
#   P=0.45 D=0.030               ->  5.5 / 0.23 /  3.61 deg
#   P=0.60 D=0.045 I=0.036       ->  0.3 / 0.02 /  0.14 deg   <- secildi
# Ayni kazanclarla strafe hali: 5.6 / 0.29 / 3.53 deg (kabul edilebilir).
# DIKKAT: bu kazanclar SIM'de bulundu; simdeki atalet ve itici geometrisi yaklasiktir
# (BlueROV2-Heavy referansi, bkz. GELISTIRME_OZETI). Gercek araca suda dogrulamadan
# TASIMA. Ayrica --defaults yalnizca eeprom SILININCE uygulanir (kullan.sh: eeprom.bin
# varsa -w verilmez); mevcut eeprom'a gecmesi icin parametre ayrica set edilmelidir.
ATC_RAT_YAW_P    0.60
ATC_RAT_YAW_D    0.045
ATC_RAT_YAW_I    0.036
